TS_PHONE_HOST=127.0.0.1
TS_PHONE_PORT=22113
# Unified TSPi entrypoints derive these paths from the installation and user.
# Standalone development needs an explicit TSPi launcher to activate Workers.
# Overrides must be absolute; shell variables, tilde, and systemd specifiers are not expanded.
# TS_PHONE_TSPI=/path/to/TSPi-installation/TSPi
# TS_PHONE_WORKSPACES=/path/to/TSPi-installation/workspaces
# TS_PHONE_STATE_DIR=/path/to/private/ts-phone-state
# TS_PHONE_BRIDGE_SOCKET=/path/to/private/runtime/ts-phone/bridge.sock
# TS_PHONE_BRIDGE_SECRET_FILE=/path/to/private/ts-phone-state/bridge.secret
# PI_CODING_AGENT_DIR=/path/to/private/pi/agent
TS_PHONE_COMMAND_TIMEOUT_MS=30000
TS_PHONE_SHUTDOWN_TIMEOUT_MS=10000
TS_PHONE_BRIDGE_HEARTBEAT_TIMEOUT_MS=45000
TS_PHONE_BRIDGE_MAX_RECORD_BYTES=8388608
TS_PHONE_MAX_BODY_BYTES=131072
TS_PHONE_EVENT_JOURNAL_SIZE=1000
TS_PHONE_EVENT_JOURNAL_MAX_BYTES=33554432
