[Unit]
Description=FRP client for TS Phone
After=network-online.target ts-phone.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/iaw/soft/frp/bin/frpc -c /home/iaw/.config/ts-phone/frpc.toml
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
