[Unit]
Description=TS Phone TSPi session broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/iaw/soft/ts-phone/current
EnvironmentFile=/home/iaw/.config/ts-phone/server.env
ExecStart=/usr/bin/node /home/iaw/soft/ts-phone/current/services/server/dist/index.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillMode=mixed
UMask=0077
RuntimeDirectory=ts-phone
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/iaw/.local/state/ts-phone
ReadWritePaths=/home/iaw/TS-pi-agent/workspaces
ReadWritePaths=-/home/iaw/TS-pi-agent/.pi/runtime-cache
ReadWritePaths=-/home/iaw/TS-pi-agent/.pi/session-host
ReadWritePaths=-/home/iaw/TS-pi-agent/.agents/runtime
ReadWritePaths=-/home/iaw/TS-pi-agent/.agents/envs
# Pi reads credentials and its model cache under a filesystem lock.
# A custom PI_CODING_AGENT_DIR needs a matching narrow ReadWritePaths override.
ReadWritePaths=-/home/iaw/.pi/agent

[Install]
WantedBy=default.target
