{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsphone.iawnix.xyz/schema/bridge-v2.json",
  "title": "TS Phone local bridge record",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "workspaceId",
    "sessionId",
    "instanceEpoch"
  ],
  "properties": {
    "protocolVersion": { "const": "ts-phone-bridge/2" },
    "type": {
      "enum": [
        "bridge.register",
        "bridge.registered",
        "bridge.heartbeat",
        "session.snapshot",
        "event.publish",
        "command.prompt",
        "command.abort",
        "command.ack",
        "approval.request",
        "approval.respond"
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "accessMode": { "enum": ["controller", "observer"] },
    "instanceEpoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "sessionGeneration": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "clientMessageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "toolCallId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "preview": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "approved": { "type": "boolean" },
    "ok": { "type": "boolean" },
    "snapshot": { "$ref": "#/$defs/sessionSnapshot" }
  },
  "additionalProperties": true,
  "$defs": {
    "sessionRuntime": {
      "type": "object",
      "required": ["schemaVersion", "model", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "ts-phone-session-runtime/1" },
        "model": {
          "type": "object",
          "required": ["provider", "id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
            "id": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": ["usedTokens", "limitTokens", "measurement"],
          "properties": {
            "usedTokens": {
              "oneOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "null" }
              ]
            },
            "limitTokens": { "type": "integer", "minimum": 1 },
            "measurement": { "const": "pi_estimate" }
          },
          "additionalProperties": false
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "sessionSnapshot": {
      "type": "object",
      "required": ["sessionId", "isStreaming", "messages"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
        "sessionName": { "type": "string", "minLength": 1, "maxLength": 500 },
        "model": { "type": "string", "minLength": 1, "maxLength": 500 },
        "runtime": { "$ref": "#/$defs/sessionRuntime" },
        "thinkingLevel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "isStreaming": { "type": "boolean" },
        "messages": { "type": "array", "maxItems": 500 },
        "messageIds": {
          "type": "array",
          "maxItems": 500,
          "items": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
        },
        "hasMore": { "type": "boolean" },
        "nextBefore": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
      },
      "additionalProperties": false
    }
  }
}
