{
  "name": "@iawnix/ts-phone-server",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "bin": {
    "ts-phone-server": "dist/index.js",
    "ts-phone-ctl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx test/process-smoke.ts",
    "start": "node dist/index.js",
    "ctl": "tsx src/cli.ts",
    "test": "tsx test/run-tests.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
